# Copy this file to .env and fill it in. Never commit .env.

# ALM server. With or without /qcbin at the end.
ALM_URL=https://alm.yourcompany.com/qcbin
ALM_DOMAIN=DEFAULT
ALM_PROJECT=YOUR_PROJECT

# Login: EITHER an API key (ALM 15+) ...
ALM_CLIENT_ID=
ALM_CLIENT_SECRET=
# ... OR a username and password (read-only access to the project is enough)
ALM_USERNAME=
ALM_PASSWORD=

# Timezone the ALM server records run times in (IANA name). Strongly recommended.
ALM_TIMEZONE=Australia/Melbourne
# Default timezone for people opening the report (they can change it in the report)
REPORT_TIMEZONE=Australia/Melbourne

# Optional: custom ALM fields for report columns. Find names with --list-fields.
# Keys: environment, application, assigned_to, planned_date, tester
# ALM_REPORT_FIELDS={"environment": "run.user-02", "application": "test.user-01"}

# Optional: company CA bundle for HTTPS (instead of --insecure)
# ALM_CA_BUNDLE=C:\certs\company-ca.pem

# Optional: where reports are written (default: ./reports)
# REPORT_OUTPUT_DIR=reports
